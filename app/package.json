{
  "name": "greencomp-syllabus-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first GreenComp syllabus review companion (Phase 1).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run verify:offline-pdf && npm run verify:subpath",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:types": "tsc --noEmit",
    "generate:sample-export": "vite-node scripts/generateSampleExport.ts",
    "verify:offline-pdf": "node scripts/verifyOfflinePdfPrecache.mjs",
    "verify:subpath": "node scripts/verifySubpathBuild.mjs"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
